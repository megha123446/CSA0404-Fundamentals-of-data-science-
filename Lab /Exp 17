import pandas as pd
import re
from collections import Counter
import matplotlib.pyplot as plt
df = pd.read_csv("data.csv")
stop_words = {"the", "and", "is", "a", "an", "of", "to", "in", "for"}
text = " ".join(df["feedback"].astype(str)).lower()
text = re.sub(r'[^\w\s]', '', text)
words = [w for w in text.split() if w not in stop_words]
frequency = Counter(words)
n = int(input("Enter N: "))
top_words = frequency.most_common(n)
print("\nTop", n, "frequent words:")
for word, count in top_words:
    print(word, ":", count)
words = [x[0] for x in top_words]
counts = [x[1] for x in top_words]
plt.bar(words, counts)
plt.xlabel("Words")
plt.ylabel("Frequency")
plt.title("Top Frequent Words in Customer Feedback")
plt.xticks(rotation=45)
plt.show()
